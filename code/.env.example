# Agent profile (selects the GeoDisaster tool surface and prompts)
MAS_AGENT_PROFILE=geodisaster

# Model backend for inference/eval: hf | ollama | openai | local_qwen.
# `stub` is available only for explicit teacher-decision infrastructure tests;
# it never substitutes tool/worker outputs.
MODEL_BACKEND=openai

# Real worker transport: direct Python execution or the controller/HTTP services.
GEODISASTER_TOOL_BACKEND=inprocess
MAS_CONTROLLER_ADDR=http://127.0.0.1:20101

# Base model (used by training and the local model backends)
GEODISASTER_MODEL_PATH=Qwen/Qwen2.5-7B-Instruct

# Dataset paths (download or clone the Hugging Face dataset, then point this root at it)
GEODISASTER_DATASET_ROOT=../geodisaster-agentic-2921
GEODISASTER_STRICT_DATA_ROOT=1
GEODISASTER_AGENT_TEST_JSONL=${GEODISASTER_DATASET_ROOT}/data/core/geodisaster_2921_test_inputs.jsonl
# Evaluator-side only; never mount or pass this file to the agent/tool sandbox.
GEODISASTER_TEST_JSONL=${GEODISASTER_DATASET_ROOT}/data/multi_agent/test_conversations.jsonl
GEODISASTER_SFT_DATA_DIR=${GEODISASTER_DATASET_ROOT}/data/multi_agent/sft_train
SINGLE_AGENT_TRAIN_FILE=${GEODISASTER_DATASET_ROOT}/data/single_agent/train_conversations.jsonl
# Evaluator-side only; contains reference answers.
SINGLE_AGENT_TEST_JSONL=${GEODISASTER_DATASET_ROOT}/data/single_agent/test_reference_conversations.jsonl

# OpenAI-compatible endpoint (leave OPENAI_API_KEY blank for local servers like vLLM/Ollama)
OPENAI_BASE_URL=
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=
